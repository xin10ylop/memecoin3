# Copy to .env (never commit). All optional in paper mode.

# --- live trading (BOTH required to arm live mode) ---
# MEMEBOT_LIVE=YES
# MEMEBOT_PRIVATE_KEY=<base58 solana keypair for a DEDICATED hot wallet>

# --- recommended for live: private RPC (Helius/QuickNode/Triton free tier) ---
# MEMEBOT_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# --- telegram notifications ---
# MEMEBOT_TG_TOKEN=123456:ABC...
# MEMEBOT_TG_CHAT=123456789
